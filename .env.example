# ---------------------------------------------------------------
# Copy to `.env` (which is git-ignored) and fill in only what you need.
#   cp .env.example .env
# Every value below is a placeholder. Never commit real keys.
# Week 1 works fully offline with LLM_PROVIDER=fake (no key, no cost).
# ---------------------------------------------------------------

# Which provider the Week 1 brand assistant uses: fake | openai | anthropic | gemini
LLM_PROVIDER=fake

# Model IDs change often. Look them up on the provider's official models page,
# and record what you used in evaluations/benchmarks/model-registry.csv.
OPENAI_API_KEY=replace-me
OPENAI_MODEL=replace-with-model-id-from-provider-docs

ANTHROPIC_API_KEY=replace-me
ANTHROPIC_MODEL=replace-with-model-id-from-provider-docs

GEMINI_API_KEY=replace-me
GEMINI_MODEL=replace-with-model-id-from-provider-docs

# Safety rail: the Week 1 client refuses to send more than this many requests per run.
LLM_MAX_REQUESTS_PER_RUN=20

# Later courses (leave as placeholders until the relevant week)
HUGGINGFACE_TOKEN=replace-me
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_ANON_KEY=replace-me
SUPABASE_SERVICE_ROLE_KEY=replace-me-server-side-only
ELEVENLABS_API_KEY=replace-me
COMFYUI_BASE_URL=http://127.0.0.1:8188
N8N_BASE_URL=http://127.0.0.1:5678
